# Copy to .env and fill in.
# Local MongoDB (Windows service on port 27017). AgriLoop uses its own "agriloop" database.
MONGODB_URI=mongodb://127.0.0.1:27017/agriloop
PORT=5001
# 32+ random characters; signs login tokens
AUTH_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Where the web app runs (CORS)
CLIENT_ORIGIN=http://localhost:3000
# Optional: free key from data.gov.in to show live district mandi prices
DATA_GOV_API_KEY=
